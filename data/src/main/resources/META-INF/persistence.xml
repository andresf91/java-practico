<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!-- acá va el datasource JTA -->
    <persistence-unit name="trabajadoresPU" transaction-type="JTA">

        <jta-data-source>java:jboss/datasources/TrabajadoresDS</jta-data-source>

        <class>andres.practicojava.modelo.TrabajadorSalud</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- update crea el esquema la primera vez y conserva los datos entre despliegues. create me borraba los datos  -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
